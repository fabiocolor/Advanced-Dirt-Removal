Image2 = Input { SourceOp = "OutputEncoding", Source = "Output", },
Image3 = Input { SourceOp = "RepairGate", Source = "Output", },
RedExpression = Input { Value = "if(a3*n1<=0,r1,if(a3*n1>=1,r2,r1+(r2-r1)*a3*n1))", },
GreenExpression = Input { Value = "if(a3*n1<=0,g1,if(a3*n1>=1,g2,g1+(g2-g1)*a3*n1))", },
BlueExpression = Input { Value = "if(a3*n1<=0,b1,if(a3*n1>=1,b2,b1+(b2-b1)*a3*n1))", },

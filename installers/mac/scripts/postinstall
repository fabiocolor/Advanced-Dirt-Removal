#!/bin/bash
# Advanced Dirt Removal: the OFX bundle is already in /Library/OFX/Plugins;
# undo it when the user chose "Uninstall Only".
# $3 = target volume (e.g. /)

set -euo pipefail

VOLUME="${3:-/}"
VOLUME="${VOLUME%/}"

BUNDLE="${VOLUME}/Library/OFX/Plugins/AdvancedDirtRemoval.ofx.bundle"
PKG_IDENTIFIER="com.fabiocolor.AdvancedDirtRemoval"
ACTION_FILE="${VOLUME}/tmp/AdvancedDirtRemoval_action"

ACTION="install"
if [ -f "$ACTION_FILE" ]; then
  ACTION="$(cat "$ACTION_FILE")"
  rm -f "$ACTION_FILE"
fi

if [ "$ACTION" = "uninstall" ]; then
  rm -rf "$BUNDLE"
  pkgutil --volume "${VOLUME:-/}" --forget "$PKG_IDENTIFIER" >/dev/null 2>&1 || true
  echo "Advanced Dirt Removal uninstalled."
else
  echo "Advanced Dirt Removal installed."
fi

#!/bin/bash
# Advanced Dirt Removal: when a previous version is installed, ask whether to
# replace it or only uninstall it. Command-line installs replace silently.
# $3 = target volume (e.g. /)

set -euo pipefail

VOLUME="${3:-/}"
VOLUME="${VOLUME%/}"

MACROS_PATH="${VOLUME}/Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/Macros"
MACRO_1="Advanced Dirt Removal.setting"
MACRO_2="Advanced Dirt Removal Cineon.setting"
BUNDLE="${VOLUME}/Library/OFX/Plugins/AdvancedDirtRemoval.ofx.bundle"
ACTION_FILE="${VOLUME}/tmp/AdvancedDirtRemoval_action"

rm -f "$ACTION_FILE"
if [ -e "${MACROS_PATH}/${MACRO_1}" ] || [ -e "${MACROS_PATH}/${MACRO_2}" ] || [ -e "$BUNDLE" ]; then
  ACTION="replace"
  if [ -z "${COMMAND_LINE_INSTALL:-}" ] && [ -x /usr/bin/osascript ]; then
    BUTTON=$(/usr/bin/osascript <<'APPLESCRIPT'
display dialog "A previous version of Advanced Dirt Removal is already installed.\n\nChoose what to do:" buttons {"Cancel", "Uninstall Only", "Replace & Install"} default button "Replace & Install" with title "Advanced Dirt Removal"
button returned of result
APPLESCRIPT
) || { echo "Installation canceled by user." >&2; exit 1; }
    case "$BUTTON" in
      "Uninstall Only") ACTION="uninstall" ;;
      "Replace & Install") ACTION="replace" ;;
      *) echo "Installation canceled by user." >&2; exit 1 ;;
    esac
  fi
  rm -f "${MACROS_PATH}/${MACRO_1}" "${MACROS_PATH}/${MACRO_2}"
  rm -rf "$BUNDLE"
  echo "$ACTION" > "$ACTION_FILE"
fi
